
@{
    ViewData["Title"] = ViewBag.model.FriendlyName;
    var files = System.Linq.Enumerable.ToList(System.Linq.Enumerable.Cast<dynamic>((System.Collections.IEnumerable)ViewBag.model.Files));
    const int MobileEagerCount = 2;
    const int DesktopEagerCount = 4;
    var blobHost = string.Empty;
    if (files.Count > 0)
    {
        var firstUrl = (string)files[0].AzureFullUlr;
        if (!string.IsNullOrWhiteSpace(firstUrl) && Uri.TryCreate(firstUrl, UriKind.Absolute, out var uri))
        {
            blobHost = uri.GetLeftPart(UriPartial.Authority);
        }
    }
}

@section Head {
    @if (!string.IsNullOrWhiteSpace(blobHost))
    {
        <link rel="preconnect" href="@blobHost" crossorigin>
    }
}

<div class="content-wrap event-page">
    <header class="event-header section-space-sm">
        <h2>@ViewBag.model.FriendlyName</h2>
        <a class="retro-action" href="/">Zpět</a>
    </header>

    <div class="event-grid" id="eventGallery">
        @for (var i = 0; i < files.Count; i++)
        {
            var galleryFile = files[i];
            <a
                href="@galleryFile.AzureFullUlr"
                class="event-grid-item"
                data-pswp-width="1400"
                data-pswp-height="933">
                <img
                    src="@galleryFile.AzureFullUlr"
                    data-src="@galleryFile.AzureFullUlr"
                    alt="@ViewBag.model.FriendlyName"
                    loading="@(i == 0 ? "eager" : "lazy")"
                    decoding="async"
                    class="@(i == 0 ? string.Empty : "is-pending")" />
            </a>
        }
    </div>
</div>

@section Scripts {
    <script type="module">
        import PhotoSwipeLightbox from 'https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe-lightbox.esm.min.js';

        const galleryElement = document.getElementById('eventGallery');
        if (galleryElement) {
            const isMobile = window.matchMedia('(max-width: 640px)').matches;
            const eagerCount = isMobile ? @MobileEagerCount : @DesktopEagerCount;
            const imgs = Array.from(galleryElement.querySelectorAll('img'));

            imgs.slice(0, eagerCount).forEach((img) => {
                const src = img.dataset.src;
                if (src) {
                    img.classList.remove('is-pending');
                }
            });

            // No width/height metadata in JSON yet, so we upgrade dimensions from loaded images.
            const anchors = galleryElement.querySelectorAll('a.event-grid-item');
            anchors.forEach((anchor) => {
                const img = anchor.querySelector('img');
                if (!img) {
                    return;
                }

                const updateDims = () => {
                    if (img.naturalWidth > 0 && img.naturalHeight > 0) {
                        anchor.dataset.pswpWidth = String(img.naturalWidth);
                        anchor.dataset.pswpHeight = String(img.naturalHeight);
                    }
                };

                if (img.complete) {
                    updateDims();
                } else {
                    img.addEventListener('load', updateDims, { once: true });
                }
            });

            const lightbox = new PhotoSwipeLightbox({
                gallery: '#eventGallery',
                children: 'a.event-grid-item',
                pswpModule: () => import('https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe.esm.min.js'),
                bgOpacity: 0.92,
                wheelToZoom: true,
                showHideAnimationType: 'zoom'
            });

            lightbox.init();
        }
    </script>
}
